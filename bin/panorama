#!/usr/bin/env bash
# Launches Panorama, or brings the running instance forward.
set -euo pipefail

root=${PANORAMA_ROOT:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}

usage() {
  cat <<EOF
Usage: panorama [option]

Display settings for Hyprland.

Options:
  --identify   Show each display's number on its screen
  --quit       Close a running Panorama
  --revert     Put back monitors.lua as it was before Panorama's last save
  --backups    List Panorama's backups of monitors.lua, newest first
  --brightness [--hdr] VALUE
               Change the focused monitor's brightness (+5%, 5%-, 40%) with an
               on-screen display, for key bindings. With --hdr, a monitor in
               HDR gets its SDR brightness changed instead (needs Panorama running).
  -h, --help   Show this help
EOF
}

# Launched from a menu entry or a keybinding there is no terminal to print to,
# so anything worth reading goes to a notification as well.
notify() {
  command -v notify-send >/dev/null || return 0
  notify-send -a Panorama -u "$1" "Panorama" "$2"
}

say() {
  echo "panorama: $*"
  [[ -t 1 ]] || notify normal "$*"
}

die() {
  echo "panorama: $*" >&2
  [[ -t 2 ]] || notify critical "$*"
  exit 1
}

revert() {
  local backup
  backup=$("$root/bin/panorama-persist" restore 2>&1) || die "${backup#panorama-persist: }"
  hyprctl reload >/dev/null 2>&1 || true
  say "restored $("$root/bin/panorama-persist" path) from $backup"
}

ipc() {
  qs -p "$root" ipc call panorama "$@" >/dev/null 2>&1
}

case "${1:-}" in
  "") ;;
  --identify) ipc identify || die "not running"; exit 0 ;;
  --quit) ipc quit || true; exit 0 ;;
  --revert) revert; exit 0 ;;
  --backups) "$root/bin/panorama-persist" backups; exit 0 ;;
  --brightness) shift; exec "$root/bin/panorama-brightness" key "$@" ;;
  -h | --help) usage; exit 0 ;;
  *) usage >&2; exit 2 ;;
esac

command -v qs >/dev/null || die "Quickshell (qs) is not installed"
[[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] || die "Hyprland is not running"

if ipc show; then
  hyprctl dispatch 'hl.dsp.focus({ window = "title:^Panorama$" })' >/dev/null 2>&1 || true
  exit 0
fi

# Hyprland tiles Quickshell's FloatingWindow, so float it with a runtime rule.
# A config reload drops the rule; it is re-added on every launch.
hyprctl eval 'hl.window_rule({ name = "panorama-float", match = { class = "^org\\.quickshell$", title = "^Panorama$" }, float = true, center = true, size = { 1100, 720 } })' >/dev/null 2>&1 || true

qs -n -d -p "$root" || die "Quickshell could not start Panorama"

# `qs -d` daemonizes before it loads the config, so its exit code says nothing
# about whether the window came up. With no terminal to show a load error on,
# wait for the instance to answer and report it if it never does.
[[ -t 2 ]] && exit 0
for _ in $(seq 1 16); do
  ipc show && exit 0
  sleep 0.25
done
die "did not start; see 'qs log' for why"
